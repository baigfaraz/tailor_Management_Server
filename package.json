{
  "name": "tailor-management-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API for Tailor Management System",
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:e2e": "node scripts/e2e-server.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-async-handler": "1.2.0",
    "mongoose": "7.4.5"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "eslint": "9.13.0",
    "globals": "15.11.0",
    "mongodb-memory-server": "10.1.2",
    "nodemon": "3.0.1",
    "prettier": "3.3.3",
    "supertest": "7.0.0",
    "vitest": "2.1.4"
  }
}
