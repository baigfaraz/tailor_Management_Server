{
  "name": "tailor-management-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API for Tailor Management System",
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:e2e": "node scripts/e2e-server.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.3.1",
    "express": "4.22.3",
    "express-async-handler": "1.2.0",
    "mongoose": "7.8.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "mongodb-memory-server": "10.4.3",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "vitest": "2.1.9"
  }
}
