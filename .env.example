# MongoDB connection string (local dev: mongodb://localhost:27017/tailor)
MONGODB_URI=
# API port (the frontend dev server proxies /api here)
PORT=5000
# Path to the built frontend; when set, the API also serves the web app (same origin)
WEB_DIST=../frontend/build
# Shop PIN each device enters once (4-8 digits). Changing it signs out every device.
SHOP_PIN=
# Random secret, at least 32 characters (e.g. openssl rand -hex 32)
SESSION_SECRET=
# Optional: comma-separated extra origins allowed to call the API
CORS_ORIGINS=
